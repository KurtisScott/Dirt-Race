{
  "name": "dirt-race",
  "version": "0.1.0",
  "description": "Dirt Race: tilt-to-steer 3D racing game for iPad (Three.js + Rapier)",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run icons && npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "physics-test": "tsx scripts/physics-test.ts",
    "test": "tsx scripts/tilt-test.ts && tsx scripts/physics-test.ts && tsx scripts/race-test.ts && tsx scripts/audio-test.ts",
    "tilt-test": "tsx scripts/tilt-test.ts",
    "race-test": "tsx scripts/race-test.ts",
    "audio-test": "tsx scripts/audio-test.ts",
    "audio-render": "node scripts/audio-render.mjs",
    "world-test": "tsx scripts/world-test.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "type": "module"
}
